# Set this in your shell; this file is a template, not loaded automatically.
# Override either setting to use another local model/server:
# S2S_MODEL=google/gemma-4-12B-it
# S2S_ENDPOINT=http://127.0.0.1:8080/v1
# S2S_API_KEY=     # only if your own server requires authentication
# Server launcher overrides (paths, not a different checkpoint by default):
# LLAMA_SERVER=/path/to/llama-server
# S2S_GGUF=/path/to/model.gguf
# S2S_CHAT_TEMPLATE=auto  # for a GGUF with its own chat template
# S2S_MODEL_PROFILE=mtp   # default; base reproduces the earlier checkpoint
# S2S_SPEC_TYPE=draft-mtp # or none/ngram-simple
# S2S_MTP_DRAFT=/path/to/matching-mtp-assistant.gguf
# S2S_DRAFT_TOKENS=3
# S2S_PARALLEL=2          # match model.max_parallel_requests
# S2S_CONTEXT=8192        # total across slots; 4096 per slot with two slots
